{
  "name": "narthex",
  "version": "0.2.0",
  "description": "Attribute-driven JavaScript utilities for Webflow sites, served from jsDelivr.",
  "homepage": "https://github.com/volentecreative/narthex",
  "repository": {
    "type": "git",
    "url": "https://github.com/volentecreative/narthex.git"
  },
  "license": "MIT",
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node test/check.mjs",
    "test": "npm run build && npm run check && node test/smoke.mjs && npm run test:migration",
    "serve": "npx http-server . -p 8787 -c-1",
    "test:migration": "node test/migration.mjs && node test/migration-christtheking.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
